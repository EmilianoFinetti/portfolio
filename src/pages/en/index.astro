---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

// Import images
import profileImg from "../../assets/images/EmilianoFinetti.jpg";
import pmfLogo from "../../assets/images/PMF_logo.png";
import gongLogo from "../../assets/images/gong_tecnology_logo.png";
import kiwiLogo from "../../assets/images/kiwi_logo.png";
import polimiLogo from "../../assets/images/polimi_logo.png";
import unitnLogo from "../../assets/images/unitn_logo.svg";
import fermiLogo from "../../assets/images/enrico_fermi_logo.png";
import mhCover from "../../assets/images/melted-hero/melted-hero-1.png";
---

<BaseLayout
    lang="en"
    title="Emiliano Finetti | Computer Engineer & Back-end Developer"
    description="Aspiring Computer Engineer at Politecnico di Milano & Back-end Developer. Passionate about complex systems, Python, Django, C++, and Edge AI."
    footerText="Created with ❤"
    cookieBannerText="This site only uses technical cookies to provide a better browsing experience."
    cookieBannerLink="Cookie Policy"
    cookieBannerBtn="Got it!"
>
    <!-- HERO SECTION -->
    <header class="hero mb-5">
        <div class="hero-ambient-glow"></div>
        <div class="container hero-content">
            <div class="row align-items-center gy-5">
                <div class="col-lg-5 text-center text-lg-end pe-lg-5">
                    <div class="hero-avatar-wrapper">
                        <div class="hero-avatar-ring"></div>
                        <Image
                            src={profileImg}
                            alt="Emiliano Finetti"
                            class="img-fluid rounded-circle profile-img"
                            style="width: 230px; height: 230px; object-fit: cover; object-position: center top;"
                        />
                    </div>
                </div>

                <div class="col-lg-7 text-center text-lg-start">
                    <h1 class="display-3 fw-bold mb-3 text-dark">
                        Emiliano Finetti
                    </h1>
                    <p
                        class="lead text-muted-custom mb-4 fs-4"
                        style="max-width: 820px; font-weight: 300; line-height: 1.6;"
                    >
                        Computer Engineer pursuing a Master's degree at <strong
                            class="text-dark fw-semibold"
                            >Politecnico di Milano</strong
                        >. Back-end developer specializing in <span
                            class="text-primary fw-semibold"
                            >Python, Django, C++, and scalable data
                            architectures</span
                        >, with hands-on experience spanning from database
                        design to Edge AI on MCUs.
                    </p>

                    <!-- CTA Buttons -->
                    <div
                        class="d-flex gap-3 justify-content-center justify-content-lg-start flex-wrap align-items-center"
                    >
                        <a
                            href="mailto:emilianofinetti@gmail.com"
                            class="hero-cta-btn hero-cta-primary"
                        >
                            <i class="fas fa-envelope"></i> Get in Touch
                        </a>
                        <a
                            href="https://www.linkedin.com/in/emiliano-finetti/"
                            target="_blank"
                            rel="noopener"
                            class="hero-cta-btn hero-cta-secondary"
                        >
                            <i class="fab fa-linkedin"></i> LinkedIn
                        </a>
                        <a
                            href="https://github.com/EmilianoFinetti"
                            target="_blank"
                            rel="noopener"
                            class="hero-cta-btn hero-cta-secondary"
                        >
                            <i class="fab fa-github"></i> GitHub
                        </a>
                        <a
                            href="/assets/files/CV - Emiliano FInetti - EN.pdf"
                            target="_blank"
                            rel="noopener"
                            download
                            class="hero-cta-btn hero-cta-accent"
                        >
                            <i class="fas fa-file-arrow-down"></i> Download CV
                        </a>
                    </div>

                    <!-- Tech Highlight Strip -->
                    <div
                        class="tech-highlight-strip justify-content-center justify-content-lg-start"
                    >
                        <span class="tech-pill"
                            ><i class="fab fa-python text-primary"></i> Python</span
                        >
                        <span class="tech-pill"
                            ><i class="fas fa-server text-primary"></i> Django</span
                        >
                        <span class="tech-pill"
                            ><i class="fas fa-code text-primary"></i> C / C++</span
                        >
                        <span class="tech-pill"
                            ><i class="fas fa-window-restore text-primary"></i> Qt
                            6</span
                        >
                        <span class="tech-pill"
                            ><i class="fas fa-database text-primary"></i> MySQL</span
                        >
                        <span class="tech-pill"
                            ><i class="fab fa-docker text-primary"></i> Docker</span
                        >
                        <span class="tech-pill"
                            ><i class="fab fa-linux text-primary"></i> Linux</span
                        >
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="container mb-5" style="max-width: 1920px;">
        <!-- ABOUT ME SECTION -->
        <section class="about mb-5 pb-3" id="about">
            <h2 class="section-title text-dark">
                <span class="section-title-icon"
                    ><i class="fas fa-user"></i></span
                >
                About Me
            </h2>
            <div
                class="card p-4 p-md-5 border-0 shadow-sm"
                style="border-radius: 20px; background-color: var(--card-bg);"
            >
                <p
                    class="fs-5 text-muted-custom mb-0"
                    style="line-height: 1.8;"
                >
                    I am an enthusiastic Computer Engineer, currently pursuing a
                    Master's degree in <strong class="text-dark"
                        >Computer Science and Engineering</strong
                    > at <strong class="text-dark">Politecnico di Milano</strong
                    >, having completed my Bachelor's degree at the University
                    of Trento. With strong backend fundamentals, I focus on
                    building resilient software architectures, database
                    performance optimization, and hardware-software integration.
                    In my professional roles, notably at Gong High-Tech S.r.l.,
                    I engineered comprehensive web management solutions using <strong
                        class="text-primary">Python and Django</strong
                    >. I am driven by curiosity, enjoy tackling complex
                    challenges, and leverage data analysis to make sound
                    engineering decisions.
                </p>
            </div>
        </section>

        <!-- EXPERIENCES SECTION -->
        <section class="experience mb-5 pb-4" id="experiences">
            <h2 class="section-title text-dark">
                <span class="section-title-icon"
                    ><i class="fas fa-briefcase"></i></span
                >
                Professional Experience
            </h2>
            <div class="row g-4">
                <div class="col-lg-4">
                    <a
                        href="/en/experiences/polimi-motorcycle-factory"
                        class="card h-100 project-card experience-card-link overflow-hidden text-decoration-none"
                    >
                        <div class="text-dark d-flex flex-column h-100">
                            <div
                                class="card-img-top bg-primary d-flex align-items-center justify-content-center overflow-hidden"
                                style="height: 220px;"
                            >
                                <Image
                                    src={pmfLogo}
                                    alt="PoliMi Motorcycle Factory"
                                    class="img-fluid object-fit-contain project-img"
                                    style="width: 38%;"
                                />
                            </div>
                            <div
                                class="card-body p-4 d-flex flex-column flex-grow-1"
                            >
                                <h3
                                    class="card-title h5 fw-bold text-dark mb-2"
                                >
                                    PoliMi Motorcycle Factory
                                </h3>
                                <div class="mb-3">
                                    <span
                                        class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1 text-wrap"
                                        >IT & Data Analysis | Nov 2025 - Present</span
                                    >
                                </div>
                                <p
                                    class="card-text text-muted-custom flex-grow-1"
                                    style="line-height: 1.6;"
                                >
                                    Development of IT infrastructure and
                                    high-frequency telemetry data analysis for
                                    racing motorcycle prototypes. Data
                                    processing to guide engineering decisions
                                    and track setup.
                                </p>
                                <span
                                    class="text-primary fw-semibold small mt-3 d-inline-flex align-items-center gap-1"
                                >
                                    View details <i
                                        class="fas fa-arrow-right ms-1"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-4">
                    <a
                        href="/en/experiences/gong-technology-high-tech"
                        class="card h-100 project-card experience-card-link overflow-hidden text-decoration-none"
                    >
                        <div class="text-dark d-flex flex-column h-100">
                            <div
                                class="card-img-top bg-primary d-flex align-items-center justify-content-center overflow-hidden"
                                style="height: 220px;"
                            >
                                <Image
                                    src={gongLogo}
                                    alt="Gong High-Tech S.r.l."
                                    class="img-fluid object-fit-contain project-img"
                                    style="width: 38%;"
                                />
                            </div>
                            <div
                                class="card-body p-4 d-flex flex-column flex-grow-1"
                            >
                                <h3
                                    class="card-title h5 fw-bold text-dark mb-2"
                                >
                                    Gong TECNOLOGY S.r.l | Gong High-Tech S.r.l.
                                </h3>
                                <div class="mb-3">
                                    <span
                                        class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1 text-wrap"
                                        >Back-end Developer | Sep 2022 - Aug
                                        2025</span
                                    >
                                </div>
                                <p
                                    class="card-text text-muted-custom flex-grow-1"
                                    style="line-height: 1.6;"
                                >
                                    Design and development of an automated web
                                    management system for agricultural livestock
                                    feeding (Django/Python). MySQL database
                                    modeling, automated testing, and CI/CD via
                                    GitHub Actions.
                                </p>
                                <span
                                    class="text-primary fw-semibold small mt-3 d-inline-flex align-items-center gap-1"
                                >
                                    View details <i
                                        class="fas fa-arrow-right ms-1"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-4">
                    <a
                        href="/en/experiences/kiwi"
                        class="card h-100 project-card experience-card-link overflow-hidden text-decoration-none"
                    >
                        <div class="text-dark d-flex flex-column h-100">
                            <div
                                class="card-img-top bg-primary d-flex align-items-center justify-content-center overflow-hidden"
                                style="height: 220px;"
                            >
                                <Image
                                    src={kiwiLogo}
                                    alt="Kiwi S.R.L."
                                    class="img-fluid object-fit-contain project-img"
                                    style="width: 70%;"
                                />
                            </div>
                            <div
                                class="card-body p-4 d-flex flex-column flex-grow-1"
                            >
                                <h3
                                    class="card-title h5 fw-bold text-dark mb-2"
                                >
                                    Kiwi S.R.L.
                                </h3>
                                <div class="mb-3">
                                    <span
                                        class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1 text-wrap"
                                        >Web Developer | Jun 2018 - Aug 2018</span
                                    >
                                </div>
                                <p
                                    class="card-text text-muted-custom flex-grow-1"
                                    style="line-height: 1.6;"
                                >
                                    Internship in full-stack web application
                                    development. Contributed to both client
                                    interface and server logic for an internal
                                    management platform.
                                </p>
                                <span
                                    class="text-primary fw-semibold small mt-3 d-inline-flex align-items-center gap-1"
                                >
                                    View details <i
                                        class="fas fa-arrow-right ms-1"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- PROJECTS SECTION -->
        <section class="projects mb-5 pb-4" id="projects">
            <h2 class="section-title text-dark">
                <span class="section-title-icon"
                    ><i class="fas fa-folder-open"></i></span
                >
                Featured Projects
            </h2>
            <div class="row g-4">
                <!-- Project 1: Qt Edge AI Coffee Machine -->
                <div class="col-lg-6">
                    <div class="card h-100 project-card overflow-hidden">
                        <div class="text-dark d-flex flex-column h-100">
                            <div class="project-cover-tech">
                                <span class="project-cover-badge">
                                    <i class="fas fa-newspaper me-1"></i> Featured
                                    on Qt Blog
                                </span>
                                <div
                                    class="d-flex align-items-center justify-content-center gap-4 text-white"
                                >
                                    <i
                                        class="fas fa-microchip"
                                        style="font-size: 4rem; opacity: 0.9;"
                                    ></i>
                                    <i
                                        class="fas fa-mug-hot"
                                        style="font-size: 4rem; opacity: 0.9;"
                                    ></i>
                                </div>
                            </div>
                            <div
                                class="card-body p-4 d-flex flex-column flex-grow-1"
                            >
                                <h3
                                    class="card-title h4 fw-bold text-dark mb-2"
                                >
                                    <a
                                        href="/en/projects/qt-coffee-machine"
                                        class="text-dark text-decoration-none stretched-link"
                                    >
                                        Qt Edge AI Coffee Machine
                                    </a>
                                </h3>
                                <div class="mb-3 d-flex flex-wrap gap-2">
                                    <span
                                        class="badge bg-success-subtle text-success fw-semibold px-2 py-1"
                                        >Developer | Oct 2025 - Jan 2026</span
                                    >
                                </div>
                                <p
                                    class="card-text text-muted-custom flex-grow-1"
                                    style="line-height: 1.6;"
                                >
                                    Engineered an intelligent coffee machine
                                    featuring facial and voice recognition on
                                    microcontrollers without cloud dependency.
                                    Selected and showcased on the official Qt
                                    Group engineering blog.
                                </p>
                                <span
                                    class="text-primary fw-semibold small mt-3 d-inline-flex align-items-center gap-1"
                                >
                                    Read project details <i
                                        class="fas fa-arrow-right ms-1"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Project 2: Melted Hero -->
                <div class="col-lg-6">
                    <div class="card h-100 project-card overflow-hidden">
                        <div class="text-dark d-flex flex-column h-100">
                            <div class="project-cover-game">
                                <span class="project-cover-badge">
                                    <i class="fab fa-itch-io me-1"></i> Playable on
                                    itch.io
                                </span>
                                <div
                                    class="d-flex align-items-center justify-content-center text-white"
                                >
                                    <i
                                        class="fas fa-gamepad"
                                        style="font-size: 4rem; opacity: 0.9;"
                                    ></i>
                                </div>
                            </div>
                            <div
                                class="card-body p-4 d-flex flex-column flex-grow-1"
                            >
                                <h3
                                    class="card-title h4 fw-bold text-dark mb-2"
                                >
                                    <a
                                        href="/en/projects/melted-hero"
                                        class="text-dark text-decoration-none stretched-link"
                                    >
                                        Melted Hero
                                    </a>
                                </h3>
                                <div class="mb-3 d-flex flex-wrap gap-2">
                                    <span
                                        class="badge bg-info-subtle text-info fw-semibold px-2 py-1"
                                        >Game Developer | Oct 2025 - Feb 2026</span
                                    >
                                </div>
                                <p
                                    class="card-text text-muted-custom flex-grow-1"
                                    style="line-height: 1.6;"
                                >
                                    High-speed platformer game developed in
                                    Unity within the Videogame Design and
                                    Programming course at Politecnico di Milano.
                                    Primary contributions to obstacle physics,
                                    UI design, and game loop architecture.
                                </p>
                                <span
                                    class="text-primary fw-semibold small mt-3 d-inline-flex align-items-center gap-1"
                                >
                                    Read project details <i
                                        class="fas fa-arrow-right ms-1"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SKILLS SECTION -->
        <section class="skills mb-5 pb-4" id="skills">
            <h2 class="section-title text-dark">
                <span class="section-title-icon"
                    ><i class="fas fa-code"></i></span
                >
                Technical Skills
            </h2>
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card h-100 skill-card p-4">
                        <div class="card-body p-0">
                            <h3 class="skill-category-title">
                                <i class="fas fa-server text-primary"></i> Back-end
                                & Languages
                            </h3>
                            <div class="skill-chips-grid">
                                <span class="skill-chip"
                                    ><i class="fab fa-python text-primary"></i> Python</span
                                >
                                <span class="skill-chip"
                                    ><i class="fas fa-globe text-primary"></i> Django</span
                                >
                                <span class="skill-chip"
                                    ><i class="fas fa-code text-primary"></i> C /
                                    C++</span
                                >
                                <span class="skill-chip"
                                    ><i class="fab fa-java text-primary"></i> Java
                                    / Kotlin</span
                                >
                                <span class="skill-chip"
                                    ><i class="fab fa-node-js text-primary"></i> Node.js</span
                                >
                                <span class="skill-chip"
                                    ><i class="fas fa-database text-primary"
                                    ></i> MySQL</span
                                >
                                <span class="skill-chip"
                                    ><i
                                        class="fas fa-network-wired text-primary"
                                    ></i> REST APIs</span
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card h-100 skill-card p-4">
                        <div class="card-body p-0">
                            <h3 class="skill-category-title">
                                <i class="fas fa-laptop-code text-primary"></i> Front-end
                                & Systems
                            </h3>
                            <div class="skill-chips-grid">
                                <span class="skill-chip"
                                    ><i class="fab fa-html5 text-primary"></i> HTML5
                                    / CSS3</span
                                >
                                <span class="skill-chip"
                                    ><i class="fab fa-js text-primary"></i> JavaScript</span
                                >
                                <span class="skill-chip"
                                    ><i class="fab fa-bootstrap text-primary"
                                    ></i> Bootstrap</span
                                >
                                <span class="skill-chip"
                                    ><i
                                        class="fas fa-window-restore text-primary"
                                    ></i> Qt Framework</span
                                >
                                <span class="skill-chip"
                                    ><i class="fab fa-git-alt text-primary"></i> Git</span
                                >
                                <span class="skill-chip"
                                    ><i class="fab fa-github text-primary"></i> GitHub
                                    Actions</span
                                >
                                <span class="skill-chip"
                                    ><i class="fab fa-docker text-primary"></i> Docker</span
                                >
                                <span class="skill-chip"
                                    ><i class="fab fa-linux text-primary"></i> Linux</span
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card h-100 skill-card p-4">
                        <div class="card-body p-0">
                            <h3 class="skill-category-title">
                                <i class="fas fa-lightbulb text-primary"></i> Methodologies
                                & Soft Skills
                            </h3>
                            <div class="skill-chips-grid">
                                <span class="skill-chip"
                                    ><i
                                        class="fas fa-magnifying-glass text-primary"
                                    ></i> Problem Solving</span
                                >
                                <span class="skill-chip"
                                    ><i class="fas fa-users text-primary"></i> Team
                                    Collaboration</span
                                >
                                <span class="skill-chip"
                                    ><i class="fas fa-chart-line text-primary"
                                    ></i> Data Analysis</span
                                >
                                <span class="skill-chip"
                                    ><i class="fas fa-vial text-primary"></i> Unit
                                    Testing & CI/CD</span
                                >
                                <span class="skill-chip"
                                    ><i class="fas fa-rotate text-primary"></i> Adaptability</span
                                >
                                <span class="skill-chip"
                                    ><i class="fas fa-book text-primary"></i> Technical
                                    Writing</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- EDUCATION SECTION -->
        <section class="education mb-5" id="education">
            <h2 class="section-title text-dark">
                <span class="section-title-icon"
                    ><i class="fas fa-user-graduate"></i></span
                >
                Academic Education
            </h2>
            <div class="d-flex flex-column gap-3">
                <a
                    href="https://www.polimi.it/"
                    target="_blank"
                    rel="noopener"
                    class="text-decoration-none"
                >
                    <div class="card education-card">
                        <div
                            class="card-body d-flex flex-column flex-md-row align-items-center gap-4 p-4"
                        >
                            <div class="education-logo-box">
                                <Image
                                    src={polimiLogo}
                                    alt="Politecnico di Milano"
                                    class="img-fluid"
                                    style="max-height: 100%; object-fit: contain;"
                                />
                            </div>
                            <div class="text-center text-md-start flex-grow-1">
                                <div
                                    class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2 mb-1"
                                >
                                    <h3 class="h5 fw-bold text-dark mb-0">
                                        Politecnico di Milano
                                    </h3>
                                    <span class="education-year-badge"
                                        >2024 - Present</span
                                    >
                                </div>
                                <p class="text-primary fw-semibold mb-1">
                                    Master of Science in Computer Science and
                                    Engineering
                                </p>
                                <p class="text-muted-custom mb-0 small">
                                    Milan, Italy
                                </p>
                            </div>
                        </div>
                    </div>
                </a>

                <a
                    href="https://www.unitn.it/it"
                    target="_blank"
                    rel="noopener"
                    class="text-decoration-none"
                >
                    <div class="card education-card">
                        <div
                            class="card-body d-flex flex-column flex-md-row align-items-center gap-4 p-4"
                        >
                            <div class="education-logo-box">
                                <Image
                                    src={unitnLogo}
                                    alt="University of Trento"
                                    class="img-fluid"
                                    style="max-height: 100%; object-fit: contain;"
                                />
                            </div>
                            <div class="text-center text-md-start flex-grow-1">
                                <div
                                    class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2 mb-1"
                                >
                                    <h3 class="h5 fw-bold text-dark mb-0">
                                        University of Trento
                                    </h3>
                                    <span class="education-year-badge"
                                        >2019 - 2024</span
                                    >
                                </div>
                                <p class="text-primary fw-semibold mb-1">
                                    Bachelor of Science in Computer, Electronic
                                    and Telecommunications Engineering
                                </p>
                                <p class="text-muted-custom mb-0 small">
                                    Trento, Italy
                                </p>
                            </div>
                        </div>
                    </div>
                </a>

                <a
                    href="https://www.fermimn.edu.it/"
                    target="_blank"
                    rel="noopener"
                    class="text-decoration-none"
                >
                    <div class="card education-card">
                        <div
                            class="card-body d-flex flex-column flex-md-row align-items-center gap-4 p-4"
                        >
                            <div class="education-logo-box">
                                <Image
                                    src={fermiLogo}
                                    alt="Enrico Fermi High School"
                                    class="img-fluid"
                                    style="max-height: 100%; object-fit: contain;"
                                />
                            </div>
                            <div class="text-center text-md-start flex-grow-1">
                                <div
                                    class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2 mb-1"
                                >
                                    <h3 class="h5 fw-bold text-dark mb-0">
                                        Enrico Fermi High School
                                    </h3>
                                    <span class="education-year-badge"
                                        >2014 - 2019</span
                                    >
                                </div>
                                <p class="text-primary fw-semibold mb-1">
                                    Scientific High School Diploma - Applied
                                    Sciences
                                </p>
