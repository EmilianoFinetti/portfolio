---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
    lang="it"
    title="404 - Pagina Non Trovata | Emiliano Finetti"
    description="La pagina che stai cercando non è disponibile."
    footerText="Creato con passione"
    cookieBannerText="Questo sito utilizza solo cookie tecnici per garantire una migliore esperienza di navigazione."
    cookieBannerLink="Cookie Policy"
    cookieBannerBtn="Capito!"
>
    <!-- Header specific to the 404 page -->
    <header class="py-4 border-bottom">
        <div class="container d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0 fw-bold text-dark">Emiliano Finetti</h1>
        </div>
    </header>

    <!-- Main content for the 404 page -->
    <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-5 my-5">
        <div class="text-center">
            <h1 class="display-1 fw-bold text-primary mb-3">404</h1>
            <h2 class="h3 fw-bold text-dark mb-3">Oops! Pagina non trovata.</h2>
            <p class="fs-5 text-muted-custom mb-5" style="max-width: 600px; margin: 0 auto;">
                La pagina che stai cercando potrebbe essere stata rimossa, aver cambiato nome o essere temporaneamente non disponibile.
            </p>
            <!-- Link to the root (Home in Italian) -->
            <a href="/" class="btn btn-primary rounded-pill px-4 py-2 fw-medium">
                <i class="fas fa-home me-2"></i> Torna alla Home
            </a>
        </div>
    </main>
</BaseLayout>