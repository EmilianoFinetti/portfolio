---
import BaseLayout from './BaseLayout.astro';

const { 
    pageLang,
    pageTitle, 
    pageDescription,
    cookieBannerText,
    cookieBannerBtn,
    homepageUrl,
    experienceUrl,
    backToExperienceText,
    companyName,
    visitCompanyText,
    role, 
    duration, 
    companyUrl,
    projectsSectionTitle
} = Astro.props;
---

<BaseLayout 
    lang={pageLang}
    title={pageTitle}
    description={pageDescription}
    footerText={pageLang === "it" ? "Creato con ❤" : "Created with ❤"}
    cookieBannerText={pageLang === "it" ? "Questo sito utilizza solo cookie tecnici per garantire un'esperienza di navigazione migliore." : "This site only uses technical cookies to ensure a better browsing experience."}
    cookieBannerLink="Cookie Policy"
    cookieBannerBtn={pageLang === "it" ? "Capito!" : "Got it!"}
>
    <!-- Secondary Header -->
    <header class="py-4 border-bottom mb-5">
        <div class="container d-flex justify-content-between align-items-center gap-3" style="max-width: 1920px">
            <a href={pageLang === "it" ? "/" : "/en/"} class="h4 mb-0 fw-bold text-dark text-decoration-none">Emiliano Finetti</a>
            <a href={experienceUrl} class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-medium">
                <i class="fas fa-arrow-left me-2"></i> {backToExperienceText}
            </a>
        </div>
    </header>

    <main class="container mb-5 experience-detail" style="max-width: 1920px">
        <!-- Experience Hero -->
        <section class="experience-hero mb-5 d-flex flex-column flex-md-row gap-4 align-items-center align-items-md-start">
            <div class="experience-logo bg-primary rounded shadow-sm d-flex align-items-center justify-content-center p-3" style="width: 150px; height: 150px; flex-shrink: 0;">
                <slot name="logo" /> <!-- Here we will pass the <Image /> tag from the page -->
            </div>
            <div>
                <p class="text-primary fw-semibold mb-2">{role} | {duration}</p>
                <h1 class="display-5 fw-bold text-dark mb-3">{companyName}</h1>
                <slot name="context" /> <!-- Here you will write the general context -->
                
                {companyUrl && (
                    <a href={companyUrl} target="_blank" rel="noopener" class="btn btn-outline-secondary mt-3 rounded-pill px-4">
                        <i class="fas fa-arrow-up-right-from-square me-2"></i> {visitCompanyText}
                    </a>
                )}
            </div>
        </section>

        <hr class="my-5 opacity-10" />

        <!-- Projects Section -->
        <section class="projects-section">
            <h2 class="h3 fw-bold text-dark mb-5"><i class="fas fa-folder-open text-primary me-2"></i>{projectsSectionTitle}</h2>
            
            <slot name="projects" /> <!-- Here we will inject the individual ProjectCard -->
            
        </section>
    </main>
</BaseLayout>